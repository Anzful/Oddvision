# Copy to .env.local for local dev. In Vercel, set these under
# Project → Settings → Environment Variables.

# Supabase (public URL + anon key are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose
SUPABASE_SERVICE_ROLE_KEY=

# Paddle — browser (client-side token: test_… = sandbox, live_… = production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# The $7.69/month price ID (pri_…)
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Paddle — server only (pdl_sdbx_… = sandbox, pdl_live_… = production)
PADDLE_API_KEY=
# Endpoint secret key of the notification destination (Paddle → Developer tools → Notifications)
PADDLE_WEBHOOK_SECRET=

# PayPal — temporary bridge, used only while the Paddle variables above are empty
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Subscription plan id (P-…)
NEXT_PUBLIC_PAYPAL_PLAN_ID=
# Shown on the pricing card; must match the plan's price (default $7.50)
NEXT_PUBLIC_PAYPAL_PRICE_LABEL=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (verifies webhook signatures)
PAYPAL_WEBHOOK_ID=

# Vercel Cron auth for /api/cron/downgrade-expired
CRON_SECRET=
